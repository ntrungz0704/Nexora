# Nexora Environment Configuration Template
# Copy to `.env` for local development. NEVER commit real `.env` secrets or PII.

NODE_ENV=development
APP_NAME=Nexora

# Ports
WEB_PORT=5173
API_PORT=3000

# Frontend Vite API Base URL (browser accessible)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Database (MySQL 8.4 LTS)
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=nexora
MYSQL_USER=nexora
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_MYSQL_PASSWORD
MYSQL_PORT=3306

# Prisma Connection String (match MYSQL_* values above when using Docker MySQL)
DATABASE_URL=mysql://nexora:REPLACE_WITH_LOCAL_MYSQL_PASSWORD@127.0.0.1:3306/nexora

# Security & CORS
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_SECRET_MIN_32_CHARS
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Email Dispatch (Production: SMTP or Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp_username
# SMTP_PASS=smtp_password
# SMTP_FROM=Nexora Support <no-reply@example.com>
# RESEND_API_KEY=re_example_api_key
